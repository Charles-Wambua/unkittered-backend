# Unkittered API — production environment.
# Copied to /opt/unkittered/unkittered.env by setup-vm.sh (chmod 600, owner
# unkittered). Fill in every CHANGE_ME, then: sudo systemctl restart unkittered-api
#
# Never commit the real file.

# ── Database: a dedicated role + database on the VM's PostgreSQL 16 ─────────
DB_URL=jdbc:postgresql://127.0.0.1:5432/unkittered
DB_USERNAME=unkittered
DB_PASSWORD=CHANGE_ME

# ── Redis (apt redis-server, localhost only) ────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Queue: ElasticMQ (SQS-compatible) on localhost; credentials are ignored ─
AWS_SQS_ENDPOINT=http://127.0.0.1:9324
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
UNKITTERED_JWT_SECRET=CHANGE_ME
# Comma-separated OAuth client ids (empty = that sign-in is switched off)
UNKITTERED_GOOGLE_CLIENT_IDS=
UNKITTERED_APPLE_CLIENT_IDS=

# ── Uploads (photos, reels, stories) ────────────────────────────────────────
UNKITTERED_STORAGE_DIR=/opt/unkittered/uploads
# Reels are short videos; nginx allows up to 60 MB per request.
UNKITTERED_MAX_UPLOAD=50MB
UNKITTERED_MAX_REQUEST=55MB

# ── Push notifications (optional): Firebase service-account JSON ────────────
# Place the NEW key (the old one was exposed; see deploy/README.md) here:
FIREBASE_CREDENTIALS=file:/opt/unkittered/firebase-service-account.json

# ── M-Pesa ──────────────────────────────────────────────────────────────────
# disabled | daraja   (never "dev" in production: it fakes payments)
UNKITTERED_MPESA_MODE=disabled
UNKITTERED_MPESA_BASE_URL=https://sandbox.safaricom.co.ke
UNKITTERED_MPESA_CONSUMER_KEY=
UNKITTERED_MPESA_CONSUMER_SECRET=
UNKITTERED_MPESA_SHORTCODE=
UNKITTERED_MPESA_PASSKEY=
# https://<your API domain>
UNKITTERED_MPESA_CALLBACK_BASE_URL=
# Long random string: openssl rand -hex 32
UNKITTERED_MPESA_CALLBACK_TOKEN=
UNKITTERED_MPESA_B2C_SHORTCODE=
UNKITTERED_MPESA_INITIATOR_NAME=
UNKITTERED_MPESA_SECURITY_CREDENTIAL=

# ── Payments: rules and providers (see application.yml, unkittered.payments) ─
# Creator share of a gift's value, withdrawal fee (percent + fixed, in earned
# Paws = KES), minimum withdrawal, and days earnings are held before withdrawal.
UNKITTERED_CREATOR_SHARE=0.5
UNKITTERED_WITHDRAWAL_FEE_PERCENT=0.15
UNKITTERED_WITHDRAWAL_FEE_FIXED=0
UNKITTERED_MIN_WITHDRAWAL=500
UNKITTERED_EARNINGS_HOLD_DAYS=7
# net (creators earn from what was actually paid, after store fees) | face
UNKITTERED_EARNINGS_BASIS=net
# Each provider: disabled | sandbox (no money moves; for testing) | live.
# M-Pesa "auto" follows UNKITTERED_MPESA_MODE. Live is wired for M-Pesa only;
# the others need their accounts (Play Console, App Store Connect, Stripe,
# PayPal) and answer "not connected yet" until then.
UNKITTERED_PAY_MPESA=auto
UNKITTERED_PAY_MPESA_COUNTRIES=KE
UNKITTERED_PAY_GOOGLE_PLAY=disabled
UNKITTERED_PAY_APP_STORE=disabled
UNKITTERED_PAY_CARD=disabled
# Store rules generally forbid selling in-app currency outside their billing,
# so card (and M-Pesa outside Google Play) belong on a web top-up page.
UNKITTERED_PAY_CARD_IN_APP=false
UNKITTERED_PAY_PAYPAL=disabled
UNKITTERED_PAY_BANK=disabled

# ── Local-testing switches: keep these false in production ──────────────────
UNKITTERED_BILLING_TRUST_CLIENT=false
UNKITTERED_LOG_RESET_CODES=false

# ── JVM: the VM is shared, so keep the heap modest ──────────────────────────
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ── Logging (application.yml defaults to DEBUG for development) ─────────────
LOGGING_LEVEL_COM_UNKITTERED=INFO
